# bha-repair-bridge — what this service reads.
# Real values live on Render, never in this repo.

# The key n8n's "BHA — Self Healer" sends in x-api-key. Without it every
# request is refused: the service will not run with authentication off.
BRIDGE_KEY=

# The n8n instance, without /api/v1 — the REST base is derived from it.
N8N_BASE_URL=https://bayshorizonnetwork.app.n8n.cloud
# An n8n instance API key with workflow read and write. Read to fetch the
# workflow and the failed execution; write because a repair edits a workflow.
N8N_API_KEY=

# The dashboard, and the key its /api/engine writes expect in x-dashboard-key.
DASHBOARD_URL=https://bha-engine-dashboard.onrender.com
DASHBOARD_INBOUND_KEY=

# The n8n webhook that posts the repair to Slack and closes the ledger incident.
REPORT_WEBHOOK_URL=
# Where that report goes when a request did not name its own report_channel.
SLACK_REPORT_CHANNEL=#bha-pipeline-errors

# Claude Code runs on OpenRouter, with the Anthropic first-party provider.
# ANTHROPIC_API_KEY is deliberately empty: set, and Claude Code uses it instead
# of the auth token below. There is no cached Anthropic login in the container.
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# Optional.
# DRY_RUN=true diagnoses and writes nothing to n8n. Default false.
DRY_RUN=false
# ANTHROPIC_MODEL is the model Claude Code runs on. The service pins
# claude-sonnet-5 itself; set this to move the pin without a release. The CLI's
# own default resolved to claude-sonnet-4-20250514 here, which is why it is pinned.
# ANTHROPIC_MODEL=claude-sonnet-5
# CLAUDE_MODEL is passed as --model and wins over ANTHROPIC_MODEL.
# CLAUDE_MODEL=
# CLAUDE_PERMISSION_MODE defaults to acceptEdits. bypassPermissions is refused
# by the CLI when the process is root, which is why it is not the default.
# CLAUDE_PERMISSION_MODE=acceptEdits
# CLAUDE_ALLOWED_TOOLS=Bash,Read,Write,Edit,Glob,Grep
# Timeouts, in milliseconds. The defaults are the ones the brief names.
# REPAIR_TIMEOUT_MS=600000
# DEEP_HEALTH_TIMEOUT_MS=60000
# RETRY_WAIT_MS=300000
# N8N_TIMEOUT_MS=30000
